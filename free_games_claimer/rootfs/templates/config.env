# Free Games Claimer Remaster configuration
# Complete option reference:
# https://github.com/P-Adamiec/Free-Games-Claimer-Remaster#configuration

# Browser
SHOW=1
WIDTH=1280
HEIGHT=720
TIMEOUT=60
VNC_LOGIN_TIMEOUT=180

# Native Remaster store selection. Add or remove stores as needed.
STORES=epic,prime,gog

# Used only when RUN_ONCE is disabled in the add-on options.
SCHEDULER_HOURS=12
# SCHEDULER_TIMEZONE=UTC
# SCHEDULER_FIXED_TIMES=
# RUN_ON_STARTUP=true

# Common credentials can be used as fallbacks for all stores.
# EMAIL=
# PASSWORD=

# Store-specific credentials take priority over EMAIL/PASSWORD.
# EG_EMAIL=
# EG_PASSWORD=
# EG_OTPKEY=
# EG_PARENTALPIN=
# EG_MOBILE=true
# EG_MOBILE_PLATFORMS=android,ios
# PG_EMAIL=
# PG_PASSWORD=
# PG_OTPKEY=
# GOG_EMAIL=
# GOG_PASSWORD=
# STEAM_USERNAME=
# STEAM_PASSWORD=
# AE_EMAIL=
# AE_PASSWORD=

# Notifications (Apprise or Discord)
# NOTIFY=
# DISCORD_WEBHOOK=
# NOTIFY_ALREADY_CLAIMED=false
# NOTIFY_CLAIM_FAILS=false
# NOTIFY_UPDATES=true
